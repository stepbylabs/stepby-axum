.env
.env.*
config/config.toml

# 数据目录（运行时生成）
data/
uploads/

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
.fleet/
.trae/
*.iml

# 文档（无需进镜像）
docs/
*.md

# CI
.github/

# OS
.DS_Store
Thumbs.db

# 测试截图
data/screenshots*/

# Node 相关（防止意外 npm install 污染构建上下文）
node_modules/
tests/
test-screenshots/
*.log

# Docker 自身
Dockerfile*
docker-compose*.yml
.dockerignore

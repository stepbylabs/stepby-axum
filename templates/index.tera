<template>
  <div class="app-container">
    <!-- 工具行：Tailwind 布局（原 el-col :span=1.5 为无效小数 + mb8 为 RuoYi 遗留类，已按样式规范改造） -->
    <div class="mb-2">
      <el-button type="primary" plain icon="Plus" class="transition-all duration-200 hover:scale-105" @click="handleAdd">新增</el-button>
    </div>

    <Transition name="fade" mode="out-in">
      <el-table v-loading="loading" :data="list" row-key="{{ pk_column.rustField | camel_case }}">
{% for col in columns %}{% if col.isList == "1" %}{% if col.html_type == "datetime" or col.html_type == "date" %}      <el-table-column label="{{ col.columnComment }}" prop="{{ col.rustField | camel_case }}" width="170" />
{% elif col.html_type == "imageUpload" %}      <el-table-column label="{{ col.columnComment }}" prop="{{ col.rustField | camel_case }}" width="90">
        <template #default="scope">
          <el-image v-if="scope.row.{{ col.rustField | camel_case }}" :src="scope.row.{{ col.rustField | camel_case }}" :preview-src-list="[scope.row.{{ col.rustField | camel_case }}]" preview-teleported fit="cover" class="w-10 h-10 rounded" />
        </template>
      </el-table-column>
{% else %}      <el-table-column label="{{ col.columnComment }}" prop="{{ col.rustField | camel_case }}" />
{% endif %}{% endif %}{% endfor %}{% if is_flow %}      <el-table-column label="审批状态" prop="status" width="110" />
{% endif %}      <el-table-column label="操作" width="{% if is_flow %}260{% else %}180{% endif %}">
        <template #default="scope">
          <el-button type="primary" link icon="Edit" class="transition-all duration-200 hover:scale-105" @click="handleEdit(scope.row)">修改</el-button>
          <el-button type="danger" link icon="Delete" class="transition-all duration-200 hover:scale-105" @click="handleDelete(scope.row)">删除</el-button>
{% if is_flow %}          <el-button v-if="['draft', 'rejected', 'withdrawn'].includes(scope.row.status)" type="warning" link icon="Promotion" class="transition-all duration-200 hover:scale-105" @click="handleSubmitFlow(scope.row)">提交审批</el-button>
{% endif %}        </template>
      </el-table-column>
      </el-table>
    </Transition>

    <!-- 新增/修改对话框 -->
    <el-dialog :title="dialog.title" v-model="dialog.visible" width="min(90%, 600px)" destroy-on-close>
      <el-form ref="formRef" :model="form" :rules="rules" label-width="100px">
{% for col in columns %}{% if col.isInsert == "1" or col.isEdit == "1" %}        <el-form-item label="{{ col.columnComment }}" prop="{{ col.rustField | camel_case }}">
{% if col.html_type == "datetime" %}          <el-date-picker v-model="form.{{ col.rustField | camel_case }}" type="datetime" value-format="YYYY-MM-DD HH:mm:ss" placeholder="请选择{{ col.columnComment }}" class="!w-full" />
{% elif col.html_type == "date" %}          <el-date-picker v-model="form.{{ col.rustField | camel_case }}" type="date" value-format="YYYY-MM-DD" placeholder="请选择{{ col.columnComment }}" class="!w-full" />
{% elif col.html_type == "textarea" %}          <el-input v-model="form.{{ col.rustField | camel_case }}" type="textarea" :rows="3" placeholder="请输入{{ col.columnComment }}" />
{# select/radio/checkbox 列需自行接入字典数据源（项目字典 store 为缓存型，无远程拉取 API），此处按普通输入生成，避免生成不可用代码 #}
{% elif col.rust_type == "i64" or col.rust_type == "i32" or col.rust_type == "f64" %}          <el-input-number v-model="form.{{ col.rustField | camel_case }}" :controls="false" placeholder="请输入{{ col.columnComment }}" class="!w-full" />
{% else %}          <el-input v-model="form.{{ col.rustField | camel_case }}" placeholder="请输入{{ col.columnComment }}" />
{% endif %}        </el-form-item>
{% endif %}{% endfor %}      </el-form>
      <template #footer>
        <el-button @click="dialog.visible = false">取消</el-button>
        <el-button type="primary" :loading="submitLoading" @click="handleSubmit">确定</el-button>
      </template>
    </el-dialog>
  </div>
</template>

<script setup lang="ts">
import { ref, reactive, onMounted } from 'vue'
import { ElMessage, type FormInstance } from 'element-plus'
import { list{{ table.className }}, add{{ table.className }}, update{{ table.className }}, del{{ table.className }}{% if is_flow %}, submitFlow{{ table.className }}{% endif %} } from '@/api/{{ table.moduleName }}/{{ table.tableName }}'

const loading = ref(false)
const list = ref<any[]>([])
const submitLoading = ref(false)
const formRef = ref<FormInstance>()

const dialog = reactive({
  visible: false,
  title: '',
  isEdit: false
})

const form = reactive<Record<string, any>>({})
const rules: Record<string, any> = {
{% for col in columns %}{% if col.isRequired == "1" and (col.isInsert == "1" or col.isEdit == "1") %}  {{ col.rustField | camel_case }}: [{ required: true, message: '请输入{{ col.columnComment }}', trigger: 'blur' }],
{% endif %}{% endfor %}}

{# 字典说明：html_type=select/radio/checkbox 且配置 dict_type 的列，生成后需按项目字典 store 自行接入选项数据 #}

async function getList() {
  loading.value = true
  try {
    const res = await list{{ table.className }}({})
    list.value = res.rows || res.data || []
  } finally {
    loading.value = false
  }
}

function resetForm() {
{% for col in columns %}{% if col.isInsert == "1" or col.isEdit == "1" %}  form.{{ col.rustField | camel_case }} = undefined
{% endif %}{% endfor %}  formRef.value?.resetFields()
}

function handleAdd() {
  resetForm()
  dialog.title = '新增{{ table.functionName }}'
  dialog.isEdit = false
  dialog.visible = true
}

function handleEdit(row: any) {
  resetForm()
  Object.assign(form, row)
  dialog.title = '修改{{ table.functionName }}'
  dialog.isEdit = true
  dialog.visible = true
}

async function handleSubmit() {
  await formRef.value?.validate()
  submitLoading.value = true
  try {
    if (dialog.isEdit) {
      await update{{ table.className }}(form)
      ElMessage.success('修改成功')
    } else {
      await add{{ table.className }}(form)
      ElMessage.success('新增成功')
    }
    dialog.visible = false
    getList()
  } finally {
    submitLoading.value = false
  }
}

async function handleDelete(row: any) {
  await del{{ table.className }}(row.{{ pk_column.rustField | camel_case }})
  ElMessage.success('删除成功')
  getList()
}
{% if is_flow %}
// flow 模板：提交审批（后端在同一事务内回写审批投影 + 开启审批轮次）
async function handleSubmitFlow(row: any) {
  await submitFlow{{ table.className }}(row.{{ pk_column.rustField | camel_case }})
  ElMessage.success('已提交审批')
  getList()
}
{% endif %}

onMounted(() => {
  getList()
})
</script>

//! {{ table.tableName }} 模块 Handler

use std::sync::Arc;
use axum::extract::{Path, State};

use crate::common::{AjaxResult, AppError, TableDataInfo, ValidatedJson};
use crate::middleware::Operator;
use crate::state::AppState;

{% if has_tenant_id %}/// 租户收敛口径：平台操作者（tid=0）→ None 全量；租户操作者 → Some(tid)。
/// 对齐项目 tenant_scope 范式（gen-tenant 修复：生成的查询默认带租户过滤）。
fn tenant_scope_of(operator: &Operator) -> Option<i64> {
    let tid = operator.tenant_id();
    if tid == 0 { None } else { Some(tid) }
}

{% endif %}pub async fn list(State(state): State<Arc<AppState>>{% if has_tenant_id %}, operator: Operator{% endif %}) -> Result<TableDataInfo<crate::entity::{{ table.tableName }}::Model>, AppError> {
{% if has_tenant_id %}    let rows = state.{{ table.tableName }}_service.get_all(tenant_scope_of(&operator)).await?;
{% else %}    let rows = state.{{ table.tableName }}_service.get_all().await?;
{% endif %}    Ok(TableDataInfo::new(rows.len() as u64, rows))
}

pub async fn get_info(State(state): State<Arc<AppState>>{% if has_tenant_id %}, operator: Operator{% endif %}, Path(id): Path<i64>) -> Result<AjaxResult<crate::entity::{{ table.tableName }}::Model>, AppError> {
{% if has_tenant_id %}    let model = state.{{ table.tableName }}_service.get_by_id(id, tenant_scope_of(&operator)).await?;
{% else %}    let model = state.{{ table.tableName }}_service.get_by_id(id).await?;
{% endif %}    Ok(AjaxResult::success(model))
}

pub async fn add(State(state): State<Arc<AppState>>, operator: Operator, ValidatedJson(dto): ValidatedJson<crate::service::{{ table.tableName }}_service::{{ table.className }}AddDto>) -> Result<AjaxResult<()>, AppError> {
{% if has_tenant_id %}    state.{{ table.tableName }}_service.create(dto, operator.username(), operator.tenant_id()).await?;
{% else %}    state.{{ table.tableName }}_service.create(dto, operator.username()).await?;
{% endif %}    Ok(AjaxResult::success_msg(&crate::tr!("msg.success.add")))
}

pub async fn edit(State(state): State<Arc<AppState>>, operator: Operator, ValidatedJson(dto): ValidatedJson<crate::service::{{ table.tableName }}_service::{{ table.className }}EditDto>) -> Result<AjaxResult<()>, AppError> {
{% if has_tenant_id %}    state.{{ table.tableName }}_service.update(dto, operator.username(), tenant_scope_of(&operator)).await?;
{% else %}    state.{{ table.tableName }}_service.update(dto, operator.username()).await?;
{% endif %}    Ok(AjaxResult::success_msg(&crate::tr!("msg.success.edit")))
}

pub async fn remove(State(state): State<Arc<AppState>>{% if has_tenant_id %}, operator: Operator{% endif %}, Path(id): Path<i64>) -> Result<AjaxResult<()>, AppError> {
{% if has_tenant_id %}    state.{{ table.tableName }}_service.delete(id, tenant_scope_of(&operator)).await?;
{% else %}    state.{{ table.tableName }}_service.delete(id).await?;
{% endif %}    Ok(AjaxResult::success_msg(&crate::tr!("msg.success.delete")))
}
{% if is_flow %}
/// 提交审批（flow 模板）：单据进入审批引擎，审批人按策略解析并**快照**进 task 行
///
/// 引擎要求 `biz_type` 已登记（见 service 的 `BIZ_TYPE` 常量注释）；未登记显式 500，不静默放行。
pub async fn submit_flow(State(state): State<Arc<AppState>>, operator: Operator, Path(id): Path<i64>) -> Result<AjaxResult<crate::entity::{{ table.tableName }}::Model>, AppError> {
    let applicant_id = operator
        .user_id()
        .parse::<i64>()
        .map_err(|_| AppError::unauthorized(&crate::tr!("error.auth.login_info_missing")))?;
    let model = state
        .{{ table.tableName }}_service
        .submit_flow(id, applicant_id, Some(operator.username()), &state.config)
        .await?;
    Ok(AjaxResult::success(model))
}
{% endif %}

# Yebot Backend Environment Variables Example
# P2-31: 环境变量示例文件
#
# 使用说明：
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 修改为实际值（.env 已在 .gitignore 中，不会提交）
# 3. 后端会通过 dotenvy::dotenv() 自动加载 .env
#
# 注意：本文件仅列出支持的环境变量键名，详细配置说明请参考 config/config.toml.example
#       环境变量会覆盖 config.toml 中的对应字段

# 数据库连接字符串（必填）
# PostgreSQL: postgres://user:pass@localhost:5432/yebot
# MySQL:      mysql://user:pass@localhost:3306/yebot
# SQLite:     sqlite://data/yebot.db?mode=rwc
DATABASE_URL=sqlite://data/yebot.db?mode=rwc

# Redis 连接字符串（必填）
REDIS_URL=redis://127.0.0.1:6379/

# JWT 配置（生产环境必须修改）
JWT_SECRET=change-me-in-production
# yebot 默认 24 小时（与 config/config.toml.example 的 expire_hours 保持一致）
JWT_EXPIRE_HOURS=24

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

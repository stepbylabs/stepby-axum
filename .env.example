# Stepby Backend Environment Variables Example
# P2-31: 环境变量示例文件
#
# 使用说明：
# 1. 复制本文件为 .env：cp .env.example .env
# 2. 修改为实际值（.env 已在 .gitignore 中，不会提交）
# 3. 后端会通过 dotenvy::dotenv() 自动加载 .env
#
# ⚠️ 本文件仅为「示例」，其中的占位值切勿直接用于生产；生产必须逐项替换为真实强值。
#
# 注意：本文件仅列出支持的环境变量键名，详细配置说明请参考 config/config.toml.example
#       环境变量会覆盖 config.toml 中的对应字段

# 数据库连接字符串（必填）
# PostgreSQL: postgres://user:pass@localhost:5432/stepby
# MySQL:      mysql://user:pass@localhost:3306/stepby
# SQLite:     sqlite://data/stepby.db?mode=rwc
DATABASE_URL=sqlite://data/stepby.db?mode=rwc

# Redis 连接字符串（必填）
# 无密码（仅本地直连）：redis://127.0.0.1:6379/
# 有密码（生产必须；口令与下方 REDIS_PASSWORD 一致）：redis://:密码@host:6379/0
REDIS_URL=redis://127.0.0.1:6379/

# JWT 配置
# JWT_SECRET：占位示例，请用 `openssl rand -base64 48`（或等价命令）生成 ≥32 字符的随机密钥后替换。
#   ⚠️ 切勿直接使用本行的占位值：它命中后端弱密钥 deny-list（change_me），复制而不修改会导致启动失败（fail-closed）。
# stepby 默认 24 小时（与 config/config.toml.example 的 expire_hours 保持一致）
JWT_SECRET=CHANGE_ME_用_openssl_rand_base64_48_生成至少32字符随机密钥
JWT_EXPIRE_HOURS=24

# ---------------------------------------------------------------------------
# 以下口令仅供 `docker compose`（axum-backend/docker-compose.yml）启动本地
# PostgreSQL / MySQL / Redis 容器使用；缺省时 compose 会直接报错（fail-fast）。
# 运行容器化数据库前必须设置；仅以宿主机方式运行后端时可留空。
# ---------------------------------------------------------------------------
# PostgreSQL 容器口令（必填）
POSTGRES_PASSWORD=
# MySQL 容器 root / 应用用户口令（必填）
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Redis 访问口令（必填；对应 REDIS_URL 需写成 redis://:该口令@host:6379/0）
REDIS_PASSWORD=

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# 全局限流实现档位（M-8 收口；可选，缺省 local = 现状）
# local：进程内令牌桶（单实例精确、无 Redis 往返）；redis：Redis 分布式令牌桶，多实例共享配额。
# ⚠️ 后端多副本（K8s 多 Pod / 多机）**必须**设为 redis，否则各实例独立计数，配额可被轮询放大 N 倍。
# ⚠️ redis 档下 Redis 命令失败一律 fail-closed 返回 503（限流器不可用却放行 = 攻击者获准）。
# 对应 config.toml 的 [rate_limit] 段（mode / key_ttl_secs），详见 config/config.toml.example。
# RATE_LIMIT_MODE=local

# 配置加密主密钥（用于 TOTP secret、IP 库 License Key 等敏感字段 AES-256-GCM 加解密）
# 任意 ≥32 字符随机字符串，SHA-256 派生为 32 字节 AES key
# 生产环境必须通过环境变量注入，禁止写入 config.toml
CONFIG_ENC_KEY=please-set-a-strong-random-key-at-least-32-chars-long

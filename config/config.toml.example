# axum-backend 配置文件模板
#
# 使用方法：
# 1. 复制本文件为 config.toml：cp config/config.toml.example config/config.toml
# 2. 修改下方占位符为真实值
# 3. 生产环境建议通过环境变量注入敏感字段（环境变量优先级高于配置文件）：
#    - DATABASE_URL：数据库连接串
#    - REDIS_URL：Redis 连接串
#    - JWT_SECRET：JWT 签名密钥（至少 32 字符）
#    - JWT_EXPIRE_HOURS：JWT 过期小时数
#    - SERVER_HOST：监听地址
#    - SERVER_PORT：监听端口
#
# 注意：config.toml 已被 .gitignore 排除，不会进入版本控制。

[server]
host = "0.0.0.0"
port = 8080
# CORS 允许的 Origin 白名单（生产环境必须显式配置，不要使用 *）
cors_origins = [
    "http://localhost:5173",
    "http://localhost:80",
]
# 可信代理 IP 白名单（CIDR 或精确 IP）
# 仅当直连客户端 IP 在此列表内时，才信任 X-Forwarded-For / X-Real-IP
# 空列表表示不信任任何代理头，直接使用 TCP 对端 IP
# 生产环境配置为反向代理的真实 IP，如 ["127.0.0.1", "10.0.0.0/8"]
trusted_proxies = []
# 是否启用 API 文档（Swagger UI / OpenAPI JSON）
# 默认 false（生产 fail-closed），开发环境显式设为 true
docs_enabled = true

[database]
# 生产环境通过环境变量 DATABASE_URL 注入，不要将真实密码写入配置文件
# 支持以下三种数据库：
#   MySQL:      mysql://user:password@host:3306/database
#   PostgreSQL: postgres://user:password@host:5432/database
#   SQLite:     sqlite://./data/yebot.db?mode=rwc
url = "mysql://CHANGE_ME:CHANGE_ME@127.0.0.1:3306/yebot"
max_connections = 10
min_connections = 1
connect_timeout = 10
idle_timeout = 600

[redis]
# 生产环境通过环境变量 REDIS_URL 注入
# 注意：当前使用 ConnectionManager（单连接多路复用），无需配置连接池大小
url = "redis://CHANGE_ME@127.0.0.1:6379/0"

[jwt]
# 生产环境通过环境变量 JWT_SECRET 注入（至少 32 字符）
# 启动时会校验：拒绝 CHANGE_ME 占位符和 < 32 字符的密钥
secret = "CHANGE_ME_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS"
expire_hours = 24
issuer = "yebot"

[monitor]
# 可观测性监控配置（慢请求 / 错误聚合 / Prometheus 指标）
# 生产环境通过环境变量 MONITOR_METRICS_TOKEN 注入，避免明文写入配置文件
#
# /metrics 端点 Bearer token：留空表示匿名可访问（便于本地 curl / 无配置拉取）
# 配置后 Prometheus 需在 scrape job 中设置 `Authorization: Bearer <token>`。
# 生产环境建议配置，或在反向代理层限制 /metrics 来源 IP。
metrics_token = ""
# 慢请求阈值（毫秒），超过即进入 /monitor/slow-sql 缓冲
slow_request_ms = 300
# 慢请求缓冲容量（保留最近 N 条）
slow_capacity = 200
# 错误聚合缓冲容量（保留最近 N 条 ERROR 日志）
error_capacity = 500

[log]
# 日志级别（枚举）：trace | debug | info | warn | error（默认 info）
# 也可通过环境变量 RUST_LOG 覆盖（如 RUST_LOG=debug）
level = "info"
# SQL 日志（生产环境建议关闭，避免泄露敏感信息）
sql_logging = false

[upload]
# 存储后端类型（F1）：local（本地文件系统，默认） | s3（S3 兼容对象存储 MinIO/AWS/OSS/COS）
# 切换 s3 后，前端无需改动，URL 由后端返回对象存储公开地址
backend = "local"
# 头像存储目录（相对路径）
avatar_dir = "uploads/avatar"
# 头像访问 URL 前缀
avatar_url_prefix = "/uploads/avatar"
# 允许的头像扩展名白名单（小写，不含点）
avatar_allowed_exts = ["jpg", "jpeg", "png", "gif"]
# 头像最大字节数（默认 5MB）
avatar_max_size = 5242880
# 通用上传文件存储目录（相对路径）
common_dir = "uploads/file"
# 通用上传文件访问 URL 前缀
common_url_prefix = "/uploads/file"
# 通用上传允许的扩展名白名单（小写，不含点）
common_allowed_exts = ["jpg", "jpeg", "png", "gif", "pdf", "doc", "docx", "xls", "xlsx", "txt", "zip"]
# 通用上传最大字节数（默认 10MB）
common_max_size = 10485760

# S3 兼容对象存储配置（backend = "s3" 时使用；敏感字段支持环境变量注入）
# access_key / secret_key 可通过 `--env UPLOAD__S3__ACCESS_KEY=...` 或环境变量注入，避免入库配置文件
[upload.s3]
access_key = "minioadmin"
secret_key = "minioadmin"
endpoint = "http://127.0.0.1:9000"
region = "us-east-1"
bucket = "yebot"
# 是否路径风格寻址（MinIO / 自建对象存储必须 true；AWS S3 可 false）
path_style = true
# 对外公开访问 URL 前缀（可为 CDN/网关，缺省回退 endpoint；留空则自动使用 endpoint）
public_endpoint = "http://127.0.0.1:9000"

[ip_location]
# MaxMindDB 离线数据库文件路径（相对路径）
# 文件不存在时所有查询返回空字符串，不影响业务流程
# 下载地址：https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
mmdb_path = "data/GeoLite2-City.mmdb"

[mail]
# 邮件 SMTP 配置（可选，未配置时邮件相关功能降级为仅 sys_notice 入库）
# 启用前请配置真实 SMTP 服务器信息
enabled = false
# SMTP 服务器主机（如 smtp.qq.com、smtp.gmail.com、smtp.163.com）
host = ""
# SMTP 服务器端口（SSL 直连 465，STARTTLS 587）
port = 465
# SMTP 登录用户名（通常为发件邮箱地址）
username = ""
# SMTP 登录密码或授权码
# 生产环境建议通过环境变量 MAIL_PASSWORD 注入，不要写入配置文件
password = ""
# 发件人邮箱地址（通常与 username 相同）
from_email = ""
# 发件人显示名称
from_name = "yebot 系统"
# 是否使用 STARTTLS（端口 587 时通常为 true，端口 465 SSL 直连时为 false）
starttls = false

# 单点登录（OIDC Provider，v4 加固后）——整段可选，缺省 enabled=false
# 生产部署硬约束：
#   ① issuer 必须为 https 绝对地址（本机回环豁免），通过环境变量 SSO_ISSUER 注入；
#   ② SSO 与前端需**同源部署**（authorize 依赖 Admin-Token Cookie，跨源需 SameSite=None 专用改造，当前不支持）；
#   ③ Redis >= 6.2（授权码一次性消费依赖 GETDEL）；
#   ④ CONFIG_ENC_KEY 必须配置（id_token_secret 信封加密，v3-P1'-4）。
[sso]
enabled = false
# OIDC issuer（发现文档 iss）；留空时回退为请求 base_url（仅限开发环境，v4-R3）
issuer = ""
code_ttl_secs = 60             # 授权码有效期（默认 60s，短 TTL 一次性使用；v5 第八轮与代码默认对齐）
id_token_ttl_secs = 3600       # ID Token 有效期（默认 1h）
access_token_ttl_secs = 3600   # SSO 访问令牌（不透明）有效期（默认 1h，v4-P0-A）
